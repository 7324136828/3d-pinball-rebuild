# Preferred ports. The launcher selects the next free port if needed.
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1

# Persistent leaderboard and game sessions; relative paths use the repository root.
PINBALL_DB_PATH=data/pinball.db
PINBALL_SESSION_TTL_SECONDS=86400

# Optional extra browser origins, comma-separated. Development origins are added automatically.
# CORS_ORIGINS=https://pinball.example.com
# PINBALL_STATIC_DIR is set automatically by run.py --production.
