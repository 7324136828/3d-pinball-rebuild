# Optional overrides of settings.json ports. Development selects the next free port.
# BACKEND_PORT=3020
# FRONTEND_PORT=3010
BACKEND_HOST=0.0.0.0

# Storage defaults to settings.json data_directory (%TEMP%/3d-pinball-rebuild).
# An explicit file override may be relative to the repository/distribution root.
# PINBALL_DB_PATH=D:/PinballData/pinball.db
PINBALL_SESSION_TTL_SECONDS=86400

# Optional extra browser origins, comma-separated. Development origins are added automatically.
# CORS_ORIGINS=https://pinball.example.com
# PINBALL_STATIC_DIR is set automatically by run.py --production.
